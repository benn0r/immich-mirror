    "These photos are no longer in your iCloud library. They stay in Immich's trash until it is emptied (30 days by default)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Fotos sind nicht mehr in deiner iCloud-Mediathek. Sie bleiben im Papierkorb von Immich, bis er geleert wird (standardmäßig nach 30 Tagen)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces photos ne sont plus dans votre bibliothèque iCloud. Elles restent dans la corbeille d'Immich jusqu'à ce qu'elle soit vidée (30 jours par défaut)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste foto non sono più nella tua libreria iCloud. Restano nel cestino di Immich finché non viene svuotato (30 giorni per impostazione predefinita)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas fotos ya no están en tu biblioteca de iCloud. Se quedan en la papelera de Immich hasta que se vacíe (30 días por defecto)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze foto's staan niet meer in je iCloud-bibliotheek. Ze blijven in de prullenbak van Immich tot die wordt geleegd (standaard na 30 dagen)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas fotografias já não estão na sua biblioteca do iCloud. Ficam no lixo do Immich até que seja esvaziado (30 dias por omissão)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essas fotos não estão mais na sua biblioteca do iCloud. Elas ficam na lixeira do Immich até ela ser esvaziada (30 dias por padrão)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De här bilderna finns inte längre i ditt iCloud-bibliotek. De ligger kvar i Immichs papperskorg tills den töms (som standard efter 30 dagar)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse billeder er ikke længere i dit iCloud-bibliotek. De bliver i Immichs papirkurv, indtil den tømmes (som standard efter 30 dage)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse bildene er ikke lenger i iCloud-biblioteket ditt. De blir liggende i papirkurven i Immich til den tømmes (som standard etter 30 dager)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nämä kuvat eivät ole enää iCloud-kirjastossasi. Ne pysyvät Immichin roskakorissa, kunnes se tyhjennetään (oletuksena 30 päivän kuluttua)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの写真はもうiCloudライブラリにありません。Immichのゴミ箱が空になるまで残ります（デフォルトでは30日）。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tych zdjęć nie ma już w Twojej bibliotece iCloud. Pozostaną w koszu Immich, dopóki nie zostanie opróżniony (domyślnie po 30 dniach)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些照片已不在你的 iCloud 图库中。它们会保留在 Immich 的废纸篓中，直到废纸篓被清空（默认 30 天）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些照片已不在你的 iCloud 圖庫中。它們會保留在 Immich 的垃圾桶中，直到垃圾桶被清空（預設 30 天）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 사진들은 더 이상 iCloud 라이브러리에 없습니다. Immich 휴지통을 비울 때까지 남아 있습니다(기본값 30일)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цих фото більше немає у вашій бібліотеці iCloud. Вони залишаться в кошику Immich, доки його не буде очищено (стандартно через 30 днів)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyto fotky už nejsou ve vaší knihovně na iCloudu. Zůstanou v koši Immich, dokud se nevysype (standardně po 30 dnech)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu fotoğraflar artık iCloud arşivinizde değil. Immich'in çöp kutusu boşaltılana kadar orada kalırlar (varsayılan olarak 30 gün)."
