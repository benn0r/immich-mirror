    "iOS runs it when it sees fit, usually overnight while charging. Turn off dry run to enable." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS führt ihn aus, wann es passt, meist nachts beim Laden. Probelauf ausschalten, um ihn zu aktivieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS la lance quand il le juge bon, généralement la nuit pendant la charge. Désactivez la simulation pour l'activer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS la esegue quando lo ritiene opportuno, di solito di notte durante la ricarica. Disattiva la simulazione per abilitarla."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS la ejecuta cuando lo considera oportuno, normalmente de noche mientras carga. Desactiva la simulación para activarla."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS voert hem uit wanneer het uitkomt, meestal 's nachts tijdens het opladen. Zet de proefrun uit om dit in te schakelen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS executa-a quando achar adequado, normalmente durante a noite enquanto carrega. Desative a simulação para a ativar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS executa quando achar melhor, normalmente à noite enquanto carrega. Desative a simulação para ativar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS kör den när det passar, oftast på natten under laddning. Stäng av testkörning för att aktivera."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS kører den, når det passer, som regel om natten under opladning. Slå prøvekørsel fra for at aktivere den."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS kjører den når det passer, som regel om natten under lading. Slå av prøvekjøring for å aktivere den."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS suorittaa sen sopivana hetkenä, yleensä yöllä latauksen aikana. Poista koeajo käytöstä ottaaksesi sen käyttöön."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSが適切なタイミングで実行します。通常は夜間の充電中です。有効にするにはテスト実行をオフにしてください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS uruchamia ją, kiedy uzna to za stosowne, zwykle w nocy podczas ładowania. Wyłącz próbę, aby ją włączyć."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 会在合适的时候运行，通常是在夜间充电时。关闭试运行即可启用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 會在適當的時候執行，通常是在夜間充電時。關閉試執行即可啟用。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS가 적절한 시점에 실행하며, 보통 밤에 충전 중일 때입니다. 활성화하려면 모의 실행을 끄십시오."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS запускає її, коли вважає за потрібне, зазвичай уночі під час заряджання. Вимкніть пробний запуск, щоб увімкнути."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ji spustí, kdy to uzná za vhodné, obvykle v noci při nabíjení. Pro zapnutí vypněte zkušební běh."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS uygun gördüğünde çalıştırır, genellikle gece şarj olurken. Etkinleştirmek için denemeyi kapatın."
          }
        }
      }
    },
