    "Keeps your Immich library identical to your iCloud Photos — new photos, edits, deletions and albums." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält deine Immich-Mediathek identisch mit deinen iCloud-Fotos – neue Fotos, Bearbeitungen, Löschungen und Alben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde votre bibliothèque Immich identique à vos Photos iCloud — nouvelles photos, retouches, suppressions et albums."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene la tua libreria Immich identica a Foto di iCloud — nuove foto, modifiche, eliminazioni e album."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene tu biblioteca de Immich idéntica a tus Fotos de iCloud — fotos nuevas, ediciones, eliminaciones y álbumes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houdt je Immich-bibliotheek gelijk aan je iCloud-foto's — nieuwe foto's, bewerkingen, verwijderingen en albums."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém a sua biblioteca do Immich igual às suas Fotografias em iCloud — novas fotografias, edições, eliminações e álbuns."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém sua biblioteca do Immich idêntica às suas Fotos do iCloud — fotos novas, edições, exclusões e álbuns."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håller ditt Immich-bibliotek identiskt med dina iCloud-bilder – nya bilder, redigeringar, raderingar och album."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holder dit Immich-bibliotek identisk med dine iCloud-billeder – nye billeder, redigeringer, sletninger og albummer."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holder Immich-biblioteket ditt identisk med iCloud-bildene dine – nye bilder, redigeringer, slettinger og album."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitää Immich-kirjastosi samana kuin iCloud-kuvasi – uudet kuvat, muokkaukset, poistot ja albumit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ImmichライブラリをiCloud写真と同じ状態に保ちます — 新しい写真、編集、削除、アルバム。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrzymuje bibliotekę Immich identyczną z Twoimi Zdjęciami iCloud — nowe zdjęcia, edycje, usunięcia i albumy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让你的 Immich 图库与 iCloud 照片保持一致 — 新照片、编辑、删除和相簿。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓你的 Immich 圖庫與 iCloud 照片保持一致 — 新照片、編輯、刪除和相簿。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immich 라이브러리를 iCloud 사진과 동일하게 유지합니다 — 새 사진, 편집, 삭제 및 앨범."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підтримує вашу бібліотеку Immich ідентичною до Фото iCloud — нові фото, редагування, видалення й альбоми."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udržuje vaši knihovnu Immich shodnou s Fotkami na iCloudu — nové fotky, úpravy, mazání a alba."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immich arşivinizi iCloud Fotoğrafları ile aynı tutar — yeni fotoğraflar, düzenlemeler, silmeler ve albümler."
          }
        }
      }
    },
