# 1Password Environment with IOS_DEVELOPMENT_TEAM, ASC_KEY_ID, ASC_ISSUER_ID and ASC_KEY_P8
# (contents of the .p8 key). Used by `npm run package`; find the ID in the 1Password app under
# Developer > View Environments > Manage environment > Copy environment ID.
OP_ENVIRONMENT_ID=YOUR_ENVIRONMENT_ID

# Apple Developer team, needed by `npm run ios`/`deploy` (project generation) without 1Password.
IOS_DEVELOPMENT_TEAM=YOUR_TEAM_ID

# Required only by `npm run deploy`.
IOS_DEVICE_ID=YOUR_IPHONE_DEVICE_ID
